# ===== rpi-configuration: Pi 4 tweaks =====
# Append to config.txt for Raspberry Pi 4 Model B & Pi 400

[all]
disable_splash=1

[pi4]
# Headless: allocate minimum RAM to GPU (works on Pi 4)
# gpu_mem=16

# Disable onboard Bluetooth (uses dtoverlay on Pi 4)
# dtoverlay=disable-bt

# Disable onboard Wi-Fi if using wired Ethernet
# dtoverlay=disable-wifi

# Turn off onboard LEDs (ACT and PWR)
# dtparam=act_led_trigger=none
# dtparam=act_led_activelow=off
# dtparam=pwr_led_trigger=none
# dtparam=pwr_led_activelow=off

# Audio: edit existing "dtparam=audio=on" to "dtparam=audio=off"

# --- Overclocking (Pi 4 BCM2711) ---
# WARNING: Requires active cooling (fan/case) and official 5V/3A power supply.
# Moderate / Safe (2.0 GHz):
# arm_freq=2000
# over_voltage=6
# gpu_freq=600
#
# High performance (2.147 GHz - silicon lottery dependent):
# arm_freq=2147
# over_voltage=8
# gpu_freq=750
