#!/usr/bin/env bash
# Mirror selected folders to BACKUP_DEST with rsync. NOT versioned: it is a copy, not history.
set -euo pipefail
. /etc/pi-backup.conf
[ -n "${BACKUP_DEST:-}" ] || { echo "BACKUP_DEST is empty in /etc/pi-backup.conf — nothing to do."; exit 0; }
for s in $BACKUP_SOURCES; do
  echo "Backing up $s ..."
  rsync -aHAX --delete --relative "$s" "${BACKUP_DEST%/}/$(hostname)/"
done
echo "Done."
