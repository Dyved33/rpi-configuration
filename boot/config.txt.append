# ===== pi-config: headless tweaks =====
# This is a universal template. For model-specific templates with pre-tuned settings,
# see the corresponding models/ directory (e.g., models/pi4/, models/pi5/, etc.).
#
# When running setup.sh on the Pi, it automatically detects your hardware model
# and applies the correct file from models/<detected-model>/config.txt.append!
#
# If applying manually, append these lines to the END of /boot/firmware/config.txt.
# NOTE: In config.txt, comments must be on their own line.

[all]
# Skip rainbow splash screen
disable_splash=1

[pi5]
# Note: gpu_mem is ignored on Pi 5 (uses dynamic CMA allocator)
# dtparam=bluetooth=off
# dtparam=pciex1_gen=3
# dtparam=act_led_trigger=none

[pi4]
# gpu_mem=16
# dtoverlay=disable-bt
# dtparam=act_led_trigger=none

[pi3]
# gpu_mem=16
# dtoverlay=disable-bt
# dtparam=act_led_trigger=none

[pi02]
# gpu_mem=16
# dtoverlay=disable-bt

[pi0]
# gpu_mem=16
# dtoverlay=dwc2

[pi2]
# gpu_mem=16

[pi1]
# gpu_mem=16
