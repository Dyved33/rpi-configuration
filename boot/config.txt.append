# ===== pi-config: headless tweaks =====
# APPEND these lines to the END of the existing config.txt (do not replace the file).
# Only lines without a leading '#' are active.
# NOTE: config.txt does not support comments at the end of a line, so every
# comment sits on its own line.

[all]
# Skip the rainbow splash screen at boot
disable_splash=1

# Headless: give the GPU the minimum RAM (ignored on Pi 5)
# gpu_mem=16

# Disable Bluetooth if you do not use it (Pi 3/4/Zero 2 W; Pi 5 needs a different overlay)
# dtoverlay=disable-bt

# Turn off the activity and power LEDs (names/behaviour are model dependent)
# dtparam=act_led_trigger=none
# dtparam=act_led_activelow=off
# dtparam=pwr_led_trigger=none
# dtparam=pwr_led_activelow=off

# Overclock (Pi 4 example). Needs a heatsink/fan and a good power supply. Can cause instability.
# arm_freq=2000
# over_voltage=6

# Audio: do NOT append "dtparam=audio=off". Instead edit the existing
# "dtparam=audio=on" line in config.txt and change it to "dtparam=audio=off".
